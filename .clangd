# clangd 配置。仅影响编辑器的代码提示，不参与实际编译。
#
# ============================================================
#  这份配置面向「在 WSL(Ubuntu 22.04) 里打开本工程」的场景。
#
#  依赖已装在 WSL 中：
#    OpenCV   4.5.4    /usr/include/opencv4
#    Eigen    3.4      /usr/include/eigen3
#    OpenVINO 2024.6.0 /opt/intel/openvino_2024.6.0
#    fmt / spdlog / yaml-cpp / nlohmann  → /usr/include
#
#  因为库真实存在，clangd 能做完整的语义检查：类型不匹配、变量名拼错、
#  参数个数不对、成员不存在，全都能提前发现。这比只看语法结构强得多，
#  所以这里不再压制任何诊断 —— 报出来的错基本都是真的。
#
#  ⚠️ 用 VS Code 打开本工程时，请通过 Remote-WSL 打开
#     （左下角绿色按钮 → Connect to WSL），不要直接开 Windows 路径。
#     Windows 侧没有这些库，会满屏假红线。
# ============================================================

CompileFlags:
  # 首选：读 cmake 生成的真实编译参数（每个文件的宏定义、include 路径都准确）。
  # 执行过 `cmake -B build` 之后这个文件就有了；不存在时 clangd 自动回退到
  # 下面 Add: 里的通用参数，也够用。
  CompilationDatabase: build

  Add:
    - -std=c++17
    # 工程自身头文件根目录，让 #include "tasks/..." "io/..." "tools/..." 可解析
    - -I.
    # 随仓库携带的串口库，gimbal.hpp 的 #include "serial/serial.h" 用到
    - -Iio/serial/include
    # 第三方库（装在 WSL 系统目录）
    - -I/usr/include/eigen3
    - -I/usr/include/opencv4
    - -I/opt/intel/openvino_2024.6.0/runtime/include

Diagnostics:
  # 不再压制任何诊断。库都在，报错就是真错，该修。
  #
  # 唯一放宽的是 include 相关的两项：本工程多个文件依赖头文件间接包含
  # （例如 gimbal.hpp 用 uint8_t 却靠 Eigen 带进 <cstdint>），
  # 开着会产生大量与代码逻辑无关的整理建议，干扰阅读。
  UnusedIncludes: None

  ClangTidy:
    # 只开几组信号强、误报少的检查：
    #   bugprone-*        真实易错模式（如 memset 参数顺序写反）
    #   performance-*     不必要的拷贝（这个工程传 cv::Mat 很多，值得看）
    # 明确关掉的：
    #   magic-numbers     这个工程里 416、32、57.3 等常量满地都是，且都有物理含义
    #   trailing-return   风格偏好，与本工程不符
    Add:
      - bugprone-*
      - performance-*
    Remove:
      - bugprone-easily-swappable-parameters
      - readability-magic-numbers
      - modernize-use-trailing-return-type

# ------------------------------------------------------------
#  如果你确实要在 Windows 侧（非 WSL）打开本工程，
#  上面的 Linux 路径全都不存在，会产生几百个假错误。
#  那种情况下把下面两行的注释去掉，可屏蔽全部诊断：
#
#  Diagnostics:
#    Suppress: "*"
# ------------------------------------------------------------
