# clangd 配置。仅影响编辑器的代码提示，不参与实际编译。
#
# ============================================================
#  本工程只能在 Linux 上真正编译，但代码可以在 Linux/WSL 或 macOS 上阅读。
#  这份配置在三台机器上通用，不含任何机器专属的绝对路径，换机器不用改：
#
#    小电脑 (Ubuntu, Remote-SSH)   /home/seven/RM27_zimiao/...
#    WSL    (Windows 上的 /mnt/d)  /mnt/d/RM27_zimiao/...
#    macOS  (Homebrew, arm64)      /Users/zy/RM27_zimiao/...
#
#  ⚠️ 在 Windows 上请通过 Remote-WSL 或 Remote-SSH 打开，不要直接开 Windows
#     路径。Windows 侧没有这些库，会满屏假红线。
#
# ------------------------------------------------------------
#  为什么这里几乎什么都不配：全靠 compile_commands.json
# ------------------------------------------------------------
#  cmake 生成的 compile_commands.json 里，每个文件的 include 路径、宏定义
#  都是按 target 精确算出来的（含 io/daheng、io/hikrobot、planner/tinympc
#  这些子目录，以及 -DOPENVINO_MAKE 等宏），比手写 -I 全且准。
#
#  clangd 会自动去找它，无需在这里指定路径。实测（clangd 21）它只认两个位置：
#      <工程根>/compile_commands.json
#      <工程根>/build/compile_commands.json
#  别的目录名（build-mac、out、cmake-build、Build）都找不到。
#
#  ⚠️ 千万不要在这里写 CompileFlags.CompilationDatabase。
#     实测：该字段一旦指向不存在的目录，clangd 会**停止**自动搜索并直接失败
#     （日志 `Failed to find compilation database`），不会回退。
#     曾因为它被写成 build-mac，在小电脑上造成整个工程满屏假红线（21 errors）。
#     不写这一行，Linux 命中 build/，Mac 靠 mac/build.sh 建的
#     build -> build-mac 软链同样命中。
#
#  各平台怎么生成：
#    小电脑/WSL   bash make.sh                       -> build/
#    macOS        ./mac/build.sh                     -> build-mac/ + build 软链
#  换分支或改过 CMakeLists 后重新生成一次（rebuild task）即可。
#
#  DB 没生成时的表现：clangd 回退到下面 Add: 的通用参数。第三方库仍能解析
#  （路径两个平台都列了），但工程内部的 #include "tasks/..." 会失败，
#  因为工程根只能靠 DB 提供。症状是满屏假红线 —— 这时先跑一次 rebuild。
# ============================================================

CompileFlags:
  # 这里只放「DB 缺失时的兜底」。DB 生效时这些会被 DB 里的真实参数覆盖，
  # 所以不必写全，也刻意不写任何机器专属的绝对路径。
  Add:
    - -std=c++17
    # ---- Linux / WSL 上的第三方库 ----
    #      OpenCV 4.5.4 / Eigen 3.4 / OpenVINO 2024.6.0
    #      fmt / spdlog / yaml-cpp / nlohmann 在 /usr/include，无需 -I
    - -I/usr/include/eigen3
    - -I/usr/include/opencv4
    - -I/opt/intel/openvino_2024.6.0/runtime/include
    # ---- macOS(Homebrew) 上的第三方库 ----
    #      装齐：brew install opencv eigen fmt spdlog yaml-cpp nlohmann-json openvino
    #      clangd 会忽略不存在的 -I 目录，所以在 Linux 上这三行自动失效。
    - -I/opt/homebrew/include
    - -I/opt/homebrew/include/eigen3
    - -I/opt/homebrew/include/opencv4

Diagnostics:
  # 不压制诊断。库都在、DB 也准，报错基本都是真错，该修。
  #
  # 唯一放宽的是 include 整理建议：本工程多个文件依赖头文件间接包含
  # （例如 gimbal.hpp 用 uint8_t 却靠 Eigen 带进 <cstdint>），
  # 开着会产生大量与代码逻辑无关的提示，干扰阅读。
  UnusedIncludes: None

  ClangTidy:
    # 只开几组信号强、误报少的检查：
    #   bugprone-*        真实易错模式（如 memset 参数顺序写反）
    #   performance-*     不必要的拷贝（这个工程传 cv::Mat 很多，值得看）
    # 明确关掉的：
    #   magic-numbers     这个工程里 416、32、57.3 等常量满地都是，且都有物理含义
    #   trailing-return   风格偏好，与本工程不符
    Add:
      - bugprone-*
      - performance-*
    Remove:
      - bugprone-easily-swappable-parameters
      - readability-magic-numbers
      - modernize-use-trailing-return-type

# ------------------------------------------------------------
#  关于 macOS 上的 Linux 内核头文件
# ------------------------------------------------------------
#  io/socketcan.hpp 用的 SocketCAN(<linux/can.h>) 和 epoll(<sys/epoll.h>)
#  是 Linux 内核特性，macOS 上不存在。它经由
#  io/cboard.hpp → aimer.hpp → shooter.hpp 被 src/rb_auto_aim_debug.cpp
#  间接包含，一个找不到的头文件会让 clangd 放弃整个翻译单元。
#
#  仓库里的 .clangd-stubs/ 按 Linux UAPI 复刻了工程用到的类型和常量，
#  只给编辑器看，不参与真实编译。它由 mac/gen_compile_commands.py 写进
#  build-mac/compile_commands.json 的每条命令里（见该脚本 -I.clangd-stubs 那行），
#  所以这里不需要、也不应该再加 -I —— 在 Linux 上加了反而有覆盖真内核头的风险。
# ------------------------------------------------------------

# ------------------------------------------------------------
#  如果你确实要在 Windows 侧（非 WSL / 非 SSH）打开本工程，
#  上面的路径全都不存在，会产生几百个假错误。
#  那种情况下把下面两行的注释去掉，可屏蔽全部诊断：
#
#  Diagnostics:
#    Suppress: "*"
# ------------------------------------------------------------
