# ---------------------------------------------------------------------------
# Build output / CMake tree (created by `cmake -B build`, see make.sh)
#
# 刻意不写尾部斜杠。带斜杠是 gitignore 的目录专用模式，只匹配目录条目，
# 挡不住同名的符号链接（git 视其为 mode 120000 的普通文件）。
# 曾因此让 Mac 上 mac/build.sh 建的 build -> build-mac 软链被提交进版本库
# （commit ad75477），拉到小电脑后变成指向不存在目录的坏链接，
# cmake 无法创建 build/CMakeFiles/pkgRedirects，Alt+, 编译直接失败。
# 去掉斜杠后目录和符号链接都会被忽略。
# ---------------------------------------------------------------------------
build

# Mac native build output (created by mac/build.sh)
build-mac

# clangd 的 compile_commands.json 软链：由 make.sh / mac/build.sh 在工程根创建，
# 各平台指向自己的产物目录。平台专属的本地产物，绝不进版本库。
compile_commands.json

# ---------------------------------------------------------------------------
# Runtime-generated directories and files.
# These do NOT exist in a fresh clone; the programs create them while running.
# ---------------------------------------------------------------------------

# Log directory created at runtime by autostart.sh (under build/)
logs/

# Written by `screen -L` in autostart.sh
*.screenlog

# Calibration capture output: JPG frames + matching quaternions, written at
# runtime by calibration/capture.cpp and read back by calibrate_input.
# Deliberately NOT tracked; each robot re-shoots its own calibration set.
assets/img_with_q/

# The calibration tool rewrites configs/calibration.yaml in place and leaves
# the previous version behind as a .bak sibling file.
*.bak

# Video recordings / captured frames written at runtime
records/
imgs/

# HikRobot SDK runtime log directory (created next to the executable)
MvSdkLog/

# ---------------------------------------------------------------------------
# Agent / tooling directories (local only, never committed)
# ---------------------------------------------------------------------------
.omo/
.codegraph/

# Python venv for tools/plot_viewer.py (matplotlib, ~120MB). Recreate with:
#   python3 -m venv .venv-plot && .venv-plot/bin/pip install matplotlib
.venv-plot/

# ---------------------------------------------------------------------------
# Editor and OS noise
# ---------------------------------------------------------------------------
*.swp
*.swo
*~
.idea/
.cache/
compile_commands.json
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# camera_tuning 按 p 键产出的调参结果。每台机器的相机、镜头、现场光照都不同，
# 这个文件是「当前这台机器的临时记录」，用完就抄进 configs/calibration.yaml，
# 进版本库只会造成无意义的冲突。
configs/tuning_result.yaml
# camera_tuning 按空格键存的快照
build*/tuning_snapshot.jpg
# 海康 SDK 传输层插件软链 (指向本机 /opt/MVS, 机器相关, 不入库)
io/hikrobot/lib/*/libMvUsb3vTL.so
io/hikrobot/lib/*/libMVGigEVisionSDK.so
io/hikrobot/lib/*/libMvCamLVision.so
io/hikrobot/lib/*/libMediaProcess.so
io/hikrobot/lib/*/libMVRender.so
io/hikrobot/lib/*/liblog4cpp_*.so
# 海康 SDK 在 GENICAM_CACHE 未设置时按字面创建的目录
$(ALLUSERSPROFILE)/
